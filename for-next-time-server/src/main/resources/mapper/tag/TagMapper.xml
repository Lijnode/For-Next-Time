<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fornexttime.tag.mapper.TagMapper">
    <resultMap id="TagResultMap" type="com.fornexttime.tag.entity.Tag">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
    </resultMap>
    <select id="findByUserIdAndName" resultMap="TagResultMap">
        SELECT id, user_id, name FROM tag
        WHERE user_id = #{userId} AND name = #{name}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (user_id, name) VALUES (#{userId}, #{name})
    </insert>
    <select id="findList" resultMap="TagResultMap">
        SELECT id, user_id, name
        FROM tag
        WHERE user_id = #{userId}
        <if test="keyword != null and keyword != ''">AND name LIKE CONCAT('%', #{keyword}, '%')</if>
        ORDER BY create_time DESC, id DESC
        LIMIT #{limit}
    </select>
    <select id="findByContentIds" resultType="com.fornexttime.content.res.ContentTagRes">
        SELECT ct.content_id AS contentId, t.id, t.name
        FROM content_tag ct INNER JOIN tag t ON t.id = ct.tag_id
        WHERE ct.content_id IN
        <foreach collection="contentIds" item="contentId" open="(" separator="," close=")">#{contentId}</foreach>
    </select>
</mapper>
