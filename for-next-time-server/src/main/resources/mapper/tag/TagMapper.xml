<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fornexttime.tag.mapper.TagMapper">
    <resultMap id="TagResultMap" type="com.fornexttime.tag.entity.Tag">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
    </resultMap>
    <select id="findByUserIdAndName" resultMap="TagResultMap">
        SELECT id, user_id, name FROM tag
        WHERE user_id = #{userId} AND name = #{name}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (user_id, name) VALUES (#{userId}, #{name})
    </insert>
</mapper>
