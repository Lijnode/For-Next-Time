<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fornexttime.auth.mapper.UserAccountMapper">

    <resultMap id="UserAccountResultMap" type="com.fornexttime.auth.entity.UserAccount">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findByUsername" resultMap="UserAccountResultMap">
        SELECT id, username, password_hash, create_time
        FROM user_account
        WHERE username = #{username}
    </select>
    <select id="findById" resultMap="UserAccountResultMap">
        SELECT id, username, password_hash, create_time
        FROM user_account
        WHERE id = #{id}
    </select>

    <update id="updatePasswordHash">
        UPDATE user_account
        SET password_hash = #{passwordHash},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_account (username, password_hash)
        VALUES (#{username}, #{passwordHash})
    </insert>
</mapper>
