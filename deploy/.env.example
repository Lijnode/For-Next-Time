# 复制为 /data/for-next-time/.env 后需填写以下三项。
# 真实 .env 不得提交或发送给他人。

FOR_NEXT_TIME_DB_USERNAME=for_next_time_app
FOR_NEXT_TIME_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
FOR_NEXT_TIME_DB_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_STRONG_ROOT_PASSWORD

# 首次执行 start.sh 时自动生成；无需手动填写或修改。
FOR_NEXT_TIME_JWT_SECRET=
