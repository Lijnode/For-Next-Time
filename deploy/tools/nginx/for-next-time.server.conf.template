# 将以下 location 块合并到现有知止 Nginx 的 HTTPS server 中；下次一定暂不需要独立域名。
# 同时在知止 Nginx 启动脚本中增加：
# -v /data/for-next-time/pc:/usr/share/nginx/html/time:ro
# -v /data/for-next-time/h5:/usr/share/nginx/html/time/m:ro
#
# 约定：知止使用 /zhizhi/，下次一定 PC 使用 /time/，移动 H5 使用 /time/m/。
# 下次一定全部入口均位于 /time/ 下，避免与知止的根路径 /api/ 规则冲突。

location = /time {
    return 301 /time/;
}

location = /time/m {
    return 301 /time/m/;
}

location ^~ /time/m/ {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /time/m/index.html;
}

location ^~ /time/ {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /time/index.html;
}

location ^~ /time/api/ {
    proxy_pass http://for-next-time-app:6688/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /time/files/ {
    proxy_pass http://for-next-time-app:6688/files/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
